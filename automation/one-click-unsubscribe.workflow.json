      "id": "89abcddd-f3cf-4e3f-acb2-e48aed96474f",
      "name": "Validate One Click",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const validate = function validateOneClickRequest(request) {\n  const invalid = { valid: false, status: 400, message: 'Invalid unsubscribe request.' };\n  const token = request?.query?.token;\n  if (typeof token !== 'string' || !token || token.length > 256 || /[\\s\\u0000-\\u001f]/u.test(token)) return invalid;\n  const body = request.body;\n  const confirmed = body === 'List-Unsubscribe=One-Click' || body?.['List-Unsubscribe'] === 'One-Click';\n  if (!confirmed) return invalid;\n  return { valid: true, token, campaignId: typeof request.query?.campaign === 'string' ? request.query.campaign : '' };\n};\nreturn [{ json: validate($input.first().json) }];"
      }
    },
